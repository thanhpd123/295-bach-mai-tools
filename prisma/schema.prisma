// ============================================================
//  Prisma Schema — Hệ thống quản lý thanh toán 295 Bạch Mai
//  Tài liệu: https://pris.ly/d/prisma-schema
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
// Enums
// ------------------------------------------------------------

/// Trạng thái của một phiếu thanh toán
enum PaymentStatus {
  PENDING /// Chờ thanh toán
  PAID /// Đã thanh toán
  REFUNDED /// Đã hoàn tiền
  CANCELLED /// Đã huỷ
}

/// Phương thức thanh toán
enum PaymentMethod {
  CASH /// Tiền mặt
  BANK_TRANSFER /// Chuyển khoản
  MOMO /// Ví MoMo
  ZALOPAY /// Ví ZaloPay
}

// ------------------------------------------------------------
// Models
// ------------------------------------------------------------

/// Bệnh nhân
model Patient {
  id        String    @id @default(cuid())
  code      String    @unique /// Mã bệnh nhân (BN-xxxx)
  name      String /// Họ tên
  dob       DateTime? /// Ngày sinh
  phone     String? /// Số điện thoại
  email     String?
  address   String?
  payments  Payment[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
}

/// Dịch vụ / hạng mục thu phí
model Service {
  id          String        @id @default(cuid())
  code        String        @unique /// Mã dịch vụ (DV-xxxx)
  name        String /// Tên dịch vụ
  description String?
  unit        String        @default("lần") /// Đơn vị tính
  price       Decimal       @db.Decimal(15, 0) /// Đơn giá (VND)
  isActive    Boolean       @default(true)
  items       PaymentItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

/// Phiếu thanh toán
model Payment {
  id          String        @id @default(cuid())
  code        String        @unique /// Mã phiếu thu (PT-xxxx)
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  patientId   String
  status      PaymentStatus @default(PENDING)
  method      PaymentMethod @default(CASH)
  totalAmount Decimal       @db.Decimal(15, 0) /// Tổng tiền (VND)
  note        String?
  paidAt      DateTime? /// Thời điểm thanh toán
  items       PaymentItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([patientId])
  @@index([status])
  @@index([createdAt])
}

/// Chi tiết dịch vụ trong một phiếu thanh toán
model PaymentItem {
  id        String  @id @default(cuid())
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceId String
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(15, 0)
  total     Decimal @db.Decimal(15, 0)

  @@index([paymentId])
  @@index([serviceId])
}
