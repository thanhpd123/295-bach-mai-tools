# ============================================================
#  Biến môi trường mẫu — copy sang `.env` và điền giá trị thật.
#  KHÔNG commit file `.env` lên Git.
# ============================================================

# Chuỗi kết nối PostgreSQL (dùng Vercel Postgres / Neon / Supabase...)
# Kết nối qua pooler (transaction mode) — dùng cho runtime query
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Kết nối trực tiếp (session mode) — dùng cho migration
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# URL công khai của ứng dụng (dùng cho SEO, metadata...)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Khoá bí mật ký JWT phiên đăng nhập (bắt buộc khi deploy)
# Tạo bằng: openssl rand -base64 32
AUTH_SECRET=""

# Token webhook SePay (dùng để xác minh chữ ký giao dịch chuyển khoản)
SEPA_WEBHOOK_SECRET=""
