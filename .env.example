# Chuỗi kết nối PostgreSQL (dùng Vercel Postgres / Neon / Supabase...)
# Ví dụ: postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/manager_payment?schema=public"

# URL công khai của ứng dụng (dùng cho SEO, metadata...)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
